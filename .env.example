# Credenciais do IBM Watson Assistant
# Obtidas em: IBM Cloud > Watson Assistant > seu serviço > Manage > API details
# Copie este arquivo para ".env" e preencha com seus valores reais.
# Se estas variáveis não forem definidas, o backend usa automaticamente o
# modo de simulação local (services/simulator_service.py) — não é necessário
# ter uma instância Watson ativa para testar o protótipo.

WATSON_ASSISTANT_APIKEY=sua_api_key_aqui
WATSON_ASSISTANT_URL=https://api.us-south.assistant.watson.cloud.ibm.com/instances/SEU_INSTANCE_ID
WATSON_ASSISTANT_ID=seu_assistant_id_aqui
