      "previous_sibling": null,
      "output": {
        "generic": [
          {
            "response_type": "text",
            "values": [
              {
                "text": "Arritmia é uma alteração no ritmo dos batimentos cardíacos — o coração pode bater rápido demais (taquicardia), devagar demais (bradicardia) ou de forma irregular. Pode ser benigna ou exigir tratamento, dependendo da causa."
              }
            ],
            "selection_policy": "sequential"
          }
        ]
      },
      "context": {}
    },
